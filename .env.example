APP_ENV=development
SECRET_KEY=replace-with-a-local-random-value
DATABASE_URL=sqlite:///instance/boiler_reviews.sqlite3
DATABASE_CONNECT_TIMEOUT_SECONDS=5
PLANNER_TIME_LIMIT_SECONDS=15
WORKER_POLL_SECONDS=1

